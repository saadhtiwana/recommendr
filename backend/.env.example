# Recommendr backend configuration. Environment variables only; never commit real values.
# Local dev: cp .env.example .env, fill in values, then `uv run --env-file .env ...`.

# development | test | preview | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (Neon Postgres) ---
# Pooled connection string (host contains "-pooler"), used by the web/API process.
# Transaction-mode pooling: tenant context is set with SET LOCAL per transaction.
DATABASE_URL=
# Direct (unpooled) connection string, used by the worker, scheduler and Alembic migrations.
DATABASE_URL_DIRECT=

# --- Auth ---
# Random secret (>= 32 bytes) for signing session cookies.
SESSION_SECRET=
# Parent domain for session cookies, e.g. .recommendr.app (empty = host-only in dev).
COOKIE_DOMAIN=
# JSON list of allowed browser origins.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Google OAuth (phase 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Platform AI provider keys (phase 4). SECRETS. Hosted free tier only; ---
# --- leave empty when self-hosting (orgs bring their own keys).          ---
PLATFORM_OPENAI_API_KEY=
PLATFORM_GEMINI_API_KEY=
PLATFORM_PERPLEXITY_API_KEY=
PLATFORM_ANTHROPIC_API_KEY=

# --- Archival: Cloudflare R2 (phase 10) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Deployment mode ---
# hosted | self_hosted. self_hosted = BYOK only, quotas disabled, no platform key,
# observation sharing only within this instance, public index disabled.
DEPLOYMENT_MODE=hosted
# Explicit override; defaults to false when DEPLOYMENT_MODE=self_hosted.
QUOTAS_ENABLED=

# --- BYOK key vault (phase 9). SECRET. ---
# Master key-encryption key (KEK): base64 of 32 random bytes. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing it makes every stored provider key unrecoverable (users must re-enter keys).
KEY_ENCRYPTION_KEY=
# Integer version of KEY_ENCRYPTION_KEY, stored with each wrapped data key.
KEY_ENCRYPTION_KEY_VERSION=1
# During rotation only: JSON map of previous versions, e.g. {"1": "<base64>"}.
KEY_ENCRYPTION_KEYS_PREVIOUS=

# --- Free tier (hosted only) ---
# Global monthly spend cap for free-tier runs on the platform keys, in USD. Released linearly
# over the month; free runs stop and the operator is alerted when it is reached.
PLATFORM_MONTHLY_BUDGET_USD=
# Where platform alerts (80% / 100% of budget, dead jobs) are sent.
PLATFORM_ALERT_EMAIL=

# --- Email (alerts, reports) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# --- MCP server (phase 11) ---
# Public base URL of the API, used as the OAuth issuer / protected resource identifier.
PUBLIC_API_URL=

# --- Observability ---
SENTRY_DSN=
