# Recommendr web (Next.js) configuration. Environment variables only; never commit real values.
# Local dev: cp .env.example .env.local
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets in them.

# Base URL of the backend API, e.g. http://localhost:8000 (dev) or https://api.recommendr.app
NEXT_PUBLIC_API_BASE_URL=

# Public site URL, used for canonical URLs, sitemap, JSON-LD and llms.txt, e.g. https://recommendr.app
NEXT_PUBLIC_SITE_URL=

# Sentry (browser) DSN. Public by design; leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Server-only: URL the Next.js server uses to reach the API (internal network when self-hosted).
API_INTERNAL_URL=
